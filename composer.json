{
  "name": "cliniva/cliniva",
  "description": "Plateforme MVC de gestion de centre de sante Cliniva.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.2",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-sodium": "*",
    "ext-fileinfo": "*",
    "ext-gd": "*",
    "dompdf/dompdf": "^3.0",
    "phpoffice/phpword": "^1.3",
    "phpmailer/phpmailer": "^6.9",
    "endroid/qr-code": "^6.0",
    "spomky-labs/otphp": "^11.3"
  },
  "autoload": {
    "psr-4": {
      "Cliniva\\": "app/"
    },
    "files": [
      "app/Helpers/security.php"
    ]
  },
  "scripts": {
    "lint": "php -l public/index.php"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
